# pnpm config for this project (npm is disabled on the target host).
#
# trust-policy=warn: the machine's global pnpm rc sets trust-policy=no-downgrade,
# which refuses vite/vitest because a newer release swapped "trusted publisher"
# for "provenance attestation" (pnpm scores that as a downgrade). We log a
# warning instead of failing the install; the lockfile pins exact versions.
trust-policy=warn

# esbuild (a vite dependency) needs its postinstall to place the platform binary.
only-built-dependencies[]=esbuild
